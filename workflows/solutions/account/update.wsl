// PUT /accounts/{accountId} — update an existing account.
// Expects URL param: accountId; JSON body: {name?, type?, parentCode?, debitCredit?, active?}
// Loads the existing doc, applies non-empty fields via BuildHierarchicalUpdate
// (which runs type-change/no-children + parent-change/cycle validations),
// persists via store.Update.
// Provided by acme-account package.
//
// Per-state failure handlers: each errorable state routes to its own
// <StateName>Failed terminal state with a LITERAL statusCode (chosen per
// failure type) and $Alias.response.message for the message. Avoids the
// WSL ?? operator which doesn't work for $Alias.field??literal when the
// alias exists but the field is missing (tokenSegmentClass includes ?),
// and avoids $? which is overwritten by worker.SetError to 500 on every
// error path.

module account_update

import persistence/store
import services/common

workflow update {
  start: Load

  state Load {
    action persistence/store/store.Get(
      collection: "accounts",
      id: $url.accountId
    ) as GetResult
    on success -> BuildDoc
    on error -> LoadFailed
  }

  state BuildDoc {
    action persistence/store/store.BuildHierarchicalUpdate(
      collection: "accounts",
      existing: $GetResult.response.doc,
      updates: {
        name: $json.name,
        type: $json.type,
        parentCode: $json.parentCode,
        debitCredit: $json.debitCredit,
        active: $json.active
      },
      typeField: "type",
      parentField: "parentCode",
      idField: "code",
      validTypes: "asset,liability,equity,revenue,expense",
      typeDirectionMapping: {asset: "debit", expense: "debit", liability: "credit", equity: "credit", revenue: "credit"}
    ) as BuiltDoc
    on success -> Update
    on error -> BuildDocFailed
  }

  state Update {
    action persistence/store/store.Update(
      collection: "accounts",
      id: $url.accountId,
      doc: $BuiltDoc.response.doc
    ) as Result
    on success -> OK
    on error -> UpdateFailed
  }

  state OK {
    action services/common/response.Response(
      value: $Result.response.doc,
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state LoadFailed {
    action services/common/response.Response(
      value: { message: $GetResult.response.message, accountId: $url.accountId },
      statusCode: 404
    ) as ErrorResult
    end fail
  }

  state BuildDocFailed {
    action services/common/response.Response(
      value: { message: $BuiltDoc.response.message, accountId: $url.accountId },
      statusCode: 400
    ) as ErrorResult
    end fail
  }

  state UpdateFailed {
    action services/common/response.Response(
      value: { message: $Result.response.message??"update failed", accountId: $url.accountId },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
