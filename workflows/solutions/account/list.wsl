// GET /accounts?type=asset — list all accounts, optionally filtered by type.
// Composes persistence/store (collection "accounts"). Empty filter returns all.
// Provided by acme-account package.

module account_list

import persistence/store
import services/common

workflow list {
  start: List

  state List {
    action persistence/store/store.List(
      collection: "accounts",
      filter: {}
    ) as Result
    on success -> OK
    on error -> Failed
  }

  state OK {
    action services/common/response.Response(
      value: { count: $Result.response.count, items: $Result.response.docs },
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state Failed {
    action services/common/response.Response(
      value: { message: "failed to list accounts" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
